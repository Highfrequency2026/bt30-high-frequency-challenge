{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "description": "Unique source identifier \u2014 preserved as text to keep leading zeros (e.g. 0001)"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "body_part": {
      "type": "string"
    },
    "equipment": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "muscle_group": {
      "type": "string"
    },
    "secondary_muscles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instructions_en": {
      "type": "string"
    },
    "instruction_steps_en": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instructions_es": {
      "type": "string"
    },
    "instructions_fr": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "gif_url": {
      "type": "string"
    },
    "media_id": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "source_created_at": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "difficulty": {
      "type": "string"
    },
    "custom_notes": {
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_active": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}