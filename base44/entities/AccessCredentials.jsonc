{
  "name": "AccessCredentials",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "qr_pass",
        "rfid",
        "pin"
      ]
    },
    "credential_token": {
      "type": "string",
      "description": "QR token or credential value \u2014 identifies the account, no sensitive PII"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "member_id",
    "credential_type",
    "credential_token",
    "active"
  ]
}