{
  "name": "StripeEvents",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Stripe event ID (evt_...) \u2014 stored to prevent duplicate webhook processing"
    },
    "event_type": {
      "type": "string",
      "description": "Stripe event type (e.g. checkout.session.completed, invoice.paid)"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "event_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}